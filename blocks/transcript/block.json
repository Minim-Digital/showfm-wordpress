{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "showfm/transcript",
	"version": "1.0.1",
	"title": "show.fm Transcript",
	"category": "embed",
	"icon": "microphone",
	"description": "A follow-along transcript for a Player on this page.",
	"keywords": [ "podcast", "transcript" ],
	"textdomain": "showfm",
	"attributes": {
		"podcast": {
			"type": "string"
		},
		"theme": {
			"type": "string"
		},
		"accent": {
			"type": "string"
		},
		"api": {
			"type": "string"
		},
		"credit": {
			"type": "string"
		},
		"load": {
			"type": "string"
		},
		"lang": {
			"type": "string"
		},
		"episode": {
			"type": "string"
		},
		"for": {
			"type": "string"
		},
		"height": {
			"type": "string"
		},
		"snapshot": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true
		}
	},
	"editorScript": "showfm-block-editor",
	"providesContext": {
		"showfm/episode": "episode"
	},
	"editorStyle": "showfm-block-editor"
}
