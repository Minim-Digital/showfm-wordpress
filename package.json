{
	"name": "showfm-wordpress",
	"version": "1.0.2",
	"private": true,
	"description": "show.fm WordPress plugin. Development tooling only.",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": "^22.12.0 || ^24.0.0 || >=26.0.0"
	},
	"scripts": {
		"build": "node scripts/embed-assets.mjs && wp-scripts build src/index.js src/admin.jsx src/notices.js",
		"start": "wp-scripts start src/index.js src/admin.jsx src/notices.js",
		"format": "wp-scripts format",
		"lint:js": "wp-scripts lint-js --max-warnings=0 --ignore-pattern 'assets/showfm-embed/**' --ignore-pattern 'dist/**'",
		"lint:md": "wp-scripts lint-md-docs",
		"env": "wp-env",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/showfm vendor/bin/phpunit",
		"test:e2e": "wp-scripts test-playwright",
		"test:js": "wp-scripts test-unit-js",
		"zip": "bash bin/build-zip.sh",
		"release": "bash bin/build-zip.sh",
		"zip:check": "node scripts/check-zip.mjs dist/showfm-$npm_package_version.zip",
		"wporg:assets": "node scripts/wporg-assets/build.mjs",
		"wporg:screenshots": "SHOWFM_SCREENSHOTS=1 wp-scripts test-playwright tests/e2e/screenshots.spec.js",
		"test:php:multisite": "wp-env run tests-cli --env-cwd=wp-content/plugins/showfm vendor/bin/phpunit -c phpunit-multisite.xml.dist",
		"format:check": "prettier --check .",
		"test:assets": "node scripts/embed-assets.mjs --check",
		"fixtures": "node scripts/generate-parity.mjs",
		"i18n:pot": "bash bin/make-pot.sh languages/showfm.pot",
		"i18n:check": "bash bin/make-pot.sh artifacts/showfm.pot && node scripts/check-pot.mjs --fresh artifacts/showfm.pot"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@showfm/embed": "1.6.2",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.7",
		"@vitejs/plugin-react-swc": "4.3.3",
		"@wordpress/a11y": "^4.57.0",
		"@wordpress/api-fetch": "^7.57.0",
		"@wordpress/block-editor": "^18.0.0",
		"@wordpress/blocks": "^16.1.0",
		"@wordpress/components": "^41.0.0",
		"@wordpress/compose": "^8.9.0",
		"@wordpress/data": "^10.56.0",
		"@wordpress/date": "^5.56.0",
		"@wordpress/dom-ready": "^4.57.0",
		"@wordpress/e2e-test-utils-playwright": "2.1.0",
		"@wordpress/element": "^8.8.0",
		"@wordpress/env": "11.16.0",
		"@wordpress/i18n": "^6.29.0",
		"@wordpress/icons": "^17.0.0",
		"@wordpress/plugins": "7.56.0",
		"@wordpress/prettier-config": "4.56.0",
		"@wordpress/primitives": "^4.57.0",
		"@wordpress/scripts": "36.0.0",
		"@wordpress/server-side-render": "^6.32.0",
		"@wordpress/url": "^4.57.0",
		"jsdom": "26.1.0",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"vite": "8.3.3",
		"vitest": "5.0.3"
	}
}
